rules_version = '2';

// Security rules for Avora. Deploy with: firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /products/{productId} {
      allow read: if true;

      // Checkout decrements stock from the client, so the only change a shopper may make
      // is lowering the stock field. Prices, names etc. are read-only.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock < resource.data.stock;

      // Managing the catalog requires an "admin" custom claim (or the Firebase console)
      allow create, delete: if signedIn() && request.auth.token.admin == true;
    }

    // Each user can only see and change their own cart
    match /users/{uid}/cart/{productId} {
      allow read, delete: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.quantity is int
        && request.resource.data.quantity > 0
        && request.resource.data.quantity <= 99;
    }

    // Orders are an append-only history: they can be created but never edited or deleted
    match /users/{uid}/orders/{orderId} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.status == 'placed'
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0;
      allow update, delete: if false;
    }
  }
}
