<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <EditText
        android:id="@+id/inputProductName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Ürün adı giriniz"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <EditText
        android:id="@+id/inputProductPrice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Fiyat giriniz"
        android:inputType="numberDecimal"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@id/inputProductName"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <Button
        android:id="@+id/btnAddElectronics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Electronics (Laptop)"
        app:layout_constraintTop_toBottomOf="@id/inputProductPrice"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnAddClothing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Clothing (T-Shirt)"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnAddElectronics"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/btnClear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Clear cart"
        android:backgroundTint="#F44336"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/btnAddClothing"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtReceipt"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:text="Cart is empty...\n"
        android:textSize="16sp"
        android:gravity="top"
        android:background="#EFEFEF"
        android:padding="10dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp"
        app:layout_constraintTop_toBottomOf="@id/btnClear"
        app:layout_constraintBottom_toTopOf="@id/txtTotal"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/txtTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Total: 0.0 TL"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#009688"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>