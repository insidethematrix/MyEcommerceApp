<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/txtHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Today's\nOpportunities!"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#333333"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <Button
        android:id="@+id/btnClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Clear cart"
        android:backgroundTint="#F44336"
        android:textSize="12sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <ImageButton
        android:id="@+id/btnLaptop"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/laptop"
        android:scaleType="centerCrop"
        android:background="#00FFFFFF"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toBottomOf="@id/txtHeader"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lblLaptop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Laptop Pro\n25.000 TL"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnLaptop"
        app:layout_constraintStart_toStartOf="@id/btnLaptop"
        app:layout_constraintEnd_toEndOf="@id/btnLaptop"/>

    <ImageButton
        android:id="@+id/btnMouse"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/mouse"
        android:scaleType="centerCrop"
        android:background="#00FFFFFF"
        android:layout_marginTop="100dp"
        app:layout_constraintTop_toBottomOf="@id/txtHeader"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lblMouse"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Mouse\n750 TL"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnMouse"
        app:layout_constraintStart_toStartOf="@id/btnMouse"
        app:layout_constraintEnd_toEndOf="@id/btnMouse"/>

    <ImageButton
        android:id="@+id/btnTshirt"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/tshirt"
        android:scaleType="centerCrop"
        android:background="#00FFFFFF"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/lblLaptop"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/lblTshirt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="T-Shirt\n350 TL"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnTshirt"
        app:layout_constraintStart_toStartOf="@id/btnTshirt"
        app:layout_constraintEnd_toEndOf="@id/btnTshirt"/>

    <ImageButton
        android:id="@+id/btnJeans"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:src="@drawable/jean"
        android:scaleType="centerCrop"
        android:background="#00FFFFFF"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toBottomOf="@id/lblMouse"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/lblJeans"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Jeans\n800 TL"
        android:gravity="center"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/btnJeans"
        app:layout_constraintStart_toStartOf="@id/btnJeans"
        app:layout_constraintEnd_toEndOf="@id/btnJeans"/>

    <TextView
        android:id="@+id/txtTotal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cart total: 0.0 TL"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="#4CAF50"
        android:gravity="center"
        android:padding="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>